# LLM Provider (OpenRouter recommended — model agnostic)
OPENROUTER_API_KEY=sk-or-xxx

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-xxx

# Gemini (for embeddings, TTS, memory loop)
GEMINI_API_KEY=xxx

# Optional: xAI (for image generation/vision)
XAI_API_KEY=xxx

# Optional: xAI Grok via OAuth subscription (SuperGrok / X Premium+) instead of
# a paid API key. Run `make xai-login` to create the token file, then switch
# the active provider to `xai-oauth`. Defaults to $CONFIG_DIR/xai_oauth.json.
# XAI_OAUTH_TOKENS=./xai_oauth.json
# Advanced overrides (rarely needed):
# XAI_OAUTH_CLIENT_ID=
# XAI_OAUTH_TOKEN_URL=

# Optional: Perplexity (for web search)
PERPLEXITY_API_KEY=xxx

# Server
PORT=8080
LOG_LEVEL=info
